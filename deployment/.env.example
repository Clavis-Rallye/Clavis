# Clavis App — Production Environment Configuration
#
# Copy this file to .env and fill it in. The .env file is gitignored — never
# commit it.
#
# Secrets (marked [SECRET]) must be generated fresh for this install. Where
# the file does not say how, make a key with:
#   openssl rand -hex 32
#
# Groups: Image, Environment, Database, Object storage, Auth/Crypto, Auth policy, Logging, Origin,
# Retention, Uploads, Product, Address search, Mail, Proxy, Feedback module
#
# Every variable below the Origin group is optional. The value shown is the
# default that applies when the variable is not set.

# === Image ===

# Tag of the images ghcr.io/clavis-rallye/clavis-{api,frontend} that you built
# on this host (deployment/README.md, section "Shared services", shows
# `docker build -t ghcr.io/clavis-rallye/clavis-api:0.9.1 src/backend`). The
# project publishes no images. The example is the release tag 0.9.1.
# REQUIRED — there is no tag "latest". The previous tag rolls the version back
# only when no database migration lies between the two releases.
IMAGE_TAG=0.9.1

# === Environment ===
#
# development | staging | production. The compose defaults to `production`
# when unset, so a prod deploy needs nothing here. `production` selects JSON
# logging and the cookie `Secure` flag (HTTPS-only). Set explicitly to
# `staging` for a staging stack reusing this compose.
ENVIRONMENT=production

# === Database ===

# Async SQLAlchemy URL of the database on the host's PostgreSQL. The host part
# is the name of the PostgreSQL container on backend_network.
# [SECRET] — make a password, for example:
#   openssl rand -hex 32
DATABASE_URL=postgresql+asyncpg://clavis:<password>@postgres:5432/clavis

# Connections per API process. The database must allow POOL_SIZE plus
# POOL_MAX_OVERFLOW connections for the API, next to its other clients.
POOL_SIZE=10
POOL_MAX_OVERFLOW=20

# === Object storage ===

# Credentials for the S3-compatible store of the host. Must have permission to
# create the bucket (the API calls ensure_bucket() on startup). A Garage
# access key is `GK` followed by 24 hex characters; the secret key is 64 hex
# characters.
# [SECRET] — a least-privilege bucket-scoped key from the Garage server is
#   the safe choice; the key generated on the server works for a first deploy.
S3_ACCESS_KEY=<gk-access-key>
S3_SECRET_KEY=<64-hex-secret-key>

# Bucket name — leave as 'clavis'.
S3_BUCKET=clavis

# S3 region — must equal the region of the store, in Garage its s3_region
# (us-east-1). A mismatch fails signed requests.
S3_REGION=us-east-1

# Host and port of the S3 API, and whether it speaks TLS. The defaults fit a
# Garage container named clavis-garage on the backend network.
S3_ENDPOINT=clavis-garage:3900
S3_SECURE=false

# === Auth/Crypto ===

# JWT signing key — minimum 32 characters. Generate fresh for this deploy:
#   openssl rand -hex 32
# [SECRET]
JWT_SECRET_KEY=<32+-char-random-string>

# HMAC key for the audit-log integrity chain. Generate fresh:
#   openssl rand -hex 32
# [SECRET]
HMAC_AUDIT_KEY=<32+-char-random-string>

# === Auth policy (non-secret) ===

SESSION_TIMEOUT_MINUTES=60
PASSWORD_MIN_LENGTH=8
PASSWORD_CRITERIA_COUNT=3
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Login attempts per client address (slowapi syntax). Needs FORWARDED_ALLOW_IPS
# below, or every user counts as the proxy's one address.
LOGIN_RATE_LIMIT=10/minute

# Registrations per client address (slowapi syntax). Checked before the password
# is hashed. Same FORWARDED_ALLOW_IPS need as the login limit.
REGISTER_RATE_LIMIT=10/minute

# Organization admins must set up a second factor before they can work.
ENFORCE_ORG_ADMIN_TOTP=true

# false: only the first organization registers itself, the operator creates the
# others. true: anybody may register a new organization.
ALLOW_UNLIMITED_ORG_REGISTRATIONS=false

# === Logging (non-secret) ===

AUDIT_LOG_RETENTION_DAYS=365
APP_LOG_RETENTION_DAYS=90
ERROR_LOG_RETENTION_DAYS=90
# The access log holds the IP address of every request.
ACCESS_LOG_RETENTION_DAYS=90

# === Origin (non-secret) ===
#
# The app is single-origin: the browser reaches the API at the same host,
# path-routed under /api by the reverse proxy. All three values are the one production
# origin / hostname.

CORS_ORIGINS=https://rallye.example.org
WEBAUTHN_RP_ID=rallye.example.org
WEBAUTHN_RP_NAME=Clavis
WEBAUTHN_ORIGIN=https://rallye.example.org

# === Retention (non-secret) ===
#
# Deletion periods in days, counted from the end of a run. LK stands for
# Löschklasse, German for deletion class. Each is the default for every
# organization of the installation. An organization changes its own in its
# settings, tab "Löschfristen". Empty: the built-in period.
#   LK_A  guest accounts and guest names in the teams          built-in 90
#   LK_B  chat messages and uploaded media                     built-in 90
#   LK_C  team names and the remaining names in the teams      built-in 365
#   LK_H  text and quiz answers, score and feedback comments   built-in 365
# Rows, points and ratings stay, so statistics and published results stay.
LK_A_DAYS=
LK_B_DAYS=
LK_C_DAYS=
LK_H_DAYS=

# A run that is not ended and had no activity for this many days counts as
# abandoned. Its guest accounts are then deleted like those of an ended run.
ABANDONED_RUN_DAYS=60

# How many days a backup can still hold data the app already deleted. Two uses:
# no deletion period may be shorter, and the privacy template states this
# period until the operator saves the real one in the operator console, page
# "Rechtstexte". Match it to your backup job.
BACKUP_ROTATION_DAYS=30

# How long a published result link stays open, restarted at every publish.
RESULT_LINK_DAYS=90

# === Uploads (non-secret) ===
#
# Size limits in MB: one for photos, audio and documents, one for video. The
# reverse proxy must accept a request body of this size.
MAX_FILE_SIZE_MB=10
MAX_VIDEO_FILE_SIZE_MB=100

# === Product (non-secret) ===

# Product name in the app shell, the page title, the headlines and the mail signature.
BRAND_NAME=Clavis

# === Address search (non-secret) ===
#
# The station form asks the regional place index first, then the outside
# service: nominatim, photon or none. `none` is the default and sends nothing
# outside; `nominatim` and `photon` send the search text to that outside
# service. Requests leave from the server.
GEOCODER_UPSTREAM=none
# Empty: the public instance of the service.
GEOCODER_UPSTREAM_URL=
# Mail address or URL of the operator. The public services ask for it.
GEOCODER_CONTACT=
# Where the map of the station form starts before a pin exists, as lat,lng.
# Empty: the middle of the imported place index, else Augsburg.
GEOCODER_MAP_CENTRE=
# The Overpass API that "geo import" downloads a region from. Empty: the public
# instance of FOSSGIS e.V., https://overpass-api.de/api/interpreter
GEOCODER_OVERPASS_URL=
# The tile server of both maps, with {z}, {x} and {y}. Empty: the FOSSGIS tiles
# in Germany, https://tile.openstreetmap.de/{z}/{x}/{y}.png
MAP_TILE_URL=
# The tile attribution as HTML. Empty: derived from the host of the tile URL.
MAP_TILE_ATTRIBUTION=

# === Mail ===
#
# The app sends mail only when SMTP_HOST and MAIL_FROM_ADDRESS are set.
# Otherwise it logs each message instead of sending it, says so at start, and
# the admin UI shows that mail is not set up. It never fails to start over mail.
SMTP_HOST=
SMTP_PORT=465
# ssl (implicit TLS, port 465) | starttls (port 587) | none
SMTP_TLS_MODE=ssl
SMTP_USERNAME=
# [SECRET]
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20
# The sender address your mail server accepts for SMTP_USERNAME. No default.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Clavis
# A mailbox a person reads. Empty: no Reply-To header, answers go to MAIL_FROM_ADDRESS.
MAIL_REPLY_TO=
# Origin of the links in mail and of the result link. Empty: WEBAUTHN_ORIGIN.
PUBLIC_BASE_URL=
# Days an invitation link stays valid.
INVITATION_EXPIRY_DAYS=7

# === Proxy (non-secret) ===
#
# The addresses of the reverse proxy. The API takes the client address from
# X-Forwarded-For only for a request from these addresses. The value shown is the
# subnet that deployment/README.md creates for proxy_network. Set the address of
# your proxy, or the subnet of your proxy network. The proxy must replace
# X-Forwarded-For with the address it sees.
# Never "*": then any client chooses its own address and passes every limit per
# address.
FORWARDED_ALLOW_IPS=172.18.0.0/16

# === Feedback module for test sessions (non-secret) ===
#
# Off in production. A test or demo installation switches it on.
QA_FEEDBACK_ENABLED=false
# [SECRET] A client that sends this value in the header X-QA-Token reads the notes. At least
# 32 characters. Empty: only an operator reads the notes.
QA_FEEDBACK_TOKEN=
QA_FEEDBACK_RETENTION_DAYS=30
QA_FEEDBACK_NOTE_RATE_LIMIT=120/minute
